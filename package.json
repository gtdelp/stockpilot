{
  "name": "stockpilot",
  "version": "1.0.1",
  "scripts": {
    "env": "node scripts/set-env.mjs",
    "env:prod": "node scripts/set-env.mjs --prod",
    "prestart": "npm run env",
    "start": "ng serve",
    "build": "npm run env:prod && ng build",
    "build:dev": "npm run env && ng build --configuration development",
    "pretest": "npm run env",
    "test": "ng test --watch=false",
    "test:coverage": "npm run env && ng test --watch=false --coverage",
    "test:api": "vitest run --config vitest.api.config.mts",
    "test:e2e": "playwright test",
    "lint": "npm run env && ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "docs": "compodoc -p tsconfig.doc.json --language es-ES --disableGraph --disablePrivate --disableProtected --disableInternal --hideGenerator --name StockPilot",
    "docs:coverage": "compodoc -p tsconfig.doc.json --language es-ES --disableGraph --disablePrivate --disableProtected --disableInternal --hideGenerator --name StockPilot -d documentation --coverageTest 90 --coverageMinimumPerFile 0 --silent",
    "icons": "node scripts/generate-icons.mjs",
    "seed": "tsx scripts/seed.ts",
    "lhci": "lhci autorun",
    "prepare": "husky || true",
    "build:e2e": "DEMO_MODE=true npm run build",
    "build:vercel": "npm run build && npm run docs -- -d www/browser/docs --silent",
    "docs:build": "compodoc -p tsconfig.doc.json --language es-ES --disableGraph --disablePrivate --disableProtected --disableInternal --hideGenerator --name StockPilot -d documentation"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.4",
    "@fontsource/inter": "^5.3.0",
    "@ionic/angular": "^9.0.10",
    "@neondatabase/serverless": "^1.2.0",
    "@ngrx/signals": "^22.0.1",
    "chart.js": "^4.6.1",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "ionicons": "^8.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@compodoc/compodoc": "^2.0.0",
    "@electric-sql/pglite": "^0.5.14",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lighthouse": "^13.6.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "description": "StockPilot: gestión de inventario y pedidos multiplataforma (Ionic + Angular).",
  "author": "Guillermo Torres",
  "engines": {
    "node": ">=22"
  }
}
