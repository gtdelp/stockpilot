# Copia este archivo como .env y rellénalo. NUNCA lo subas al repositorio.

# --- Firebase (cliente web) — Consola Firebase > Configuración del proyecto > Tus apps
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Firebase Admin (solo servidor) — JSON de la cuenta de servicio codificado en base64
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- PostgreSQL (Neon) — cadena de conexión
DATABASE_URL=

# --- Usuarios de prueba que crea el script de seed (solo en tu .env local)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
